      "recent_exams[]._id",
      "recent_exams[].accession_number",
      "recent_exams[].patient_id",
      "recent_exams[].scanner_id",
      "recent_exams[].protocoled_by",
      "recent_exams[].modality",
      "recent_exams[].procedure_code",
      "recent_exams[].procedure_name",
      "recent_exams[].body_part",
      "recent_exams[].laterality",
      "recent_exams[].priority",
      "recent_exams[].status",
