      "cycles",
      "lessor",
      "seat_config",
      "seat_config.business",
      "seat_config.premium_economy",
      "seat_config.economy",
      "cabin_features[]",
      "recent_work_orders[]",
      "recent_work_orders[]._id",
      "recent_work_orders[].wo_number",
      "recent_work_orders[].airframe",
      "recent_work_orders[].check_type",
      "recent_work_orders[].ata_chapter",
      "recent_work_orders[].station",
      "recent_work_orders[].performed_at",
      "recent_work_orders[].labor_hours",
      "recent_work_orders[].work_performed",
      "recent_work_orders[].certifying_licence",
      "recent_work_orders[].reported_by",
