  "relationships": [
    {
      "from_field": "work_orders.airframe",
      "to_collection": "aircraft"
    },
    {
      "from_field": "work_orders.reported_by",
      "to_collection": "crew_members"
    },
    {
      "from_field": "flights.aircraft.aircraft_id",
      "to_collection": "aircraft"
    },
    {
      "from_field": "flights.pilots[]",
      "to_collection": "crew_members"
    },
    {
      "from_field": "flights.dispatch_release.accepted_by",
      "to_collection": "crew_members"
    },
    {
      "from_field": "engine_trend_logs.flight_id",
      "to_collection": "flights"
    }
  ],
  "patterns": [
    {
      "path": "aircraft.seat_config",
      "pattern": "Embedding",
      "evidence": "seat_config is a nested object holding the seat count per cabin (business, economy) that exists only inside each aircraft document."
    },
    {
      "path": "aircraft.cabin_features[]",
      "pattern": "Array",
      "evidence": "cabin_features is a short list of plain strings describing the cabin equipment of the aircraft, e.g. \"wifi\"; its length varies by aircraft."
    },
    {
      "path": "aircraft.recent_work_orders[]",
      "pattern": "Subset",
      "evidence": "recent_work_orders holds at most 3 work orders of the aircraft, the most recent by performed_at, copied unchanged from the work_orders collection; an aircraft with 4 work orders keeps only the latest 3 and the oldest A-check is left out."
    },
    {
      "path": "work_orders.airframe",
      "pattern": "Referencing",
      "evidence": "airframe stores only the prefixed _id of an aircraft document, e.g. \"AC-4101\", with no aircraft attribute copied."
    },
    {
      "path": "work_orders.reported_by",
      "pattern": "Referencing",
      "evidence": "reported_by holds only the ObjectId of the crew_members document of the pilot who logged the defect; no crew data is copied."
    },
    {
      "path": "crew_members.home_address",
      "pattern": "Embedding",
      "evidence": "home_address is a nested object (street, city, postal_code, country) stored only inside the crew member document."
    },
    {
      "path": "crew_members.languages[]",
      "pattern": "Array",
      "evidence": "languages is a bounded list of plain language codes spoken by the pilot, e.g. \"en\", with 2 or 3 values."
    },
    {
      "path": "crew_members.licences[]",
      "pattern": "Embedding",
      "evidence": "licences is an array of sub-documents (kind, number, authority, issued_on, expires_on) that exist only inside the crew member; no collection stores licences."
    },
    {
      "path": "flights.aircraft",
      "pattern": "ExtendedReference",
      "evidence": "aircraft groups aircraft_id with registration and type_code copied from the referenced aircraft document, e.g. registration \"EI-ZQA\", so the flight can show the tail without a lookup; many flights point to the same aircraft."
    },
    {
      "path": "flights.pilots[]",
      "pattern": "Referencing",
      "evidence": "pilots is a list of ObjectIds of crew_members documents only, with 2 or 3 entries per flight and no copied crew fields."
    },
    {
      "path": "flights.dispatch_release",
      "pattern": "Embedding",
      "evidence": "dispatch_release is a nested object with release time and fuel figures that belongs only to the flight document."
    },
    {
      "path": "flights.dispatch_release.accepted_by",
      "pattern": "Referencing",
      "evidence": "accepted_by, nested inside dispatch_release, holds only the ObjectId of the crew_members document of the commander who signed the release."
    },
    {
      "path": "flights.block_times",
      "pattern": "Embedding",
      "evidence": "block_times is a nested object with the actual off_block, takeoff, landing and on_block times, stored only inside the flight."
    },
    {
      "path": "flights.load_figures[]",
      "pattern": "Embedding",
      "evidence": "load_figures is an array of sub-documents with booked and boarded passengers per cabin, e.g. cabin \"J\", existing only inside the flight."
    },
    {
      "path": "engine_trend_logs.flight_id",
      "pattern": "Referencing",
      "evidence": "flight_id contains only the ObjectId of the flights document during which the engine data was recorded."
    },
    {
      "path": "engine_trend_logs.samples[]",
      "pattern": "Bucket",
      "evidence": "Each document groups 2 to 6 time-ordered engine samples (recorded_at, n1_pct, egt_c, fuel_flow_kgh) of one engine on one flight, framed by window_start and window_end, with sample_count equal to the number of samples."
    }
  ]
}